# `mock` is allowed only outside production. Production defaults to `feishu`.
ADMIN_AUTH_MODE=mock
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Local development uses deterministic fixtures. Set `remote` only for an HTTPS deployed API.
ADMIN_DATA_SOURCE=fixture
ADMIN_API_ORIGIN=https://admin-api.example.invalid
# Use a distinct random value of at least 32 characters in production.
PLUM_ADMIN_BFF_TOKEN=
# Remote writes are fail-closed in every environment until explicitly enabled.
ADMIN_API_WRITE_ENABLED=false
# Uploaded project documents persist here. Relative paths resolve from the repository root.
PROJECT_DOCUMENTS_DIR=data/project-documents

# Feishu OAuth authorization-code flow. No ordinary OpenAPI scope is required.
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3001/api/auth/feishu/callback

#FEISHU_REDIRECT_URI=https://admin.plum.top/api/auth/feishu/callback

# Memory-evaluation reports published from the ai4all_bridge repo. Leave empty to remove the
# entire /eval entry point; the console then behaves exactly as it did before the feature.
# Admin role only, and each report is served in its own CSP sandbox.
ADMIN_EVAL_REPORTS_DIR=
# How long published read-only diagnosis reports survive on this host. They contain real user
# conversations, so this mirrors the backend's PLUM_DEBUG_CONSOLE_RETENTION_DAYS default of 7.
# The /eval list and deploy/eval-inspect-sweep.mjs both read this value.
ADMIN_EVAL_INSPECT_RETENTION_DAYS=7
