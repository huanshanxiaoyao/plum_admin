# `mock` is allowed only outside production. Production defaults to `feishu`.
ADMIN_AUTH_MODE=mock
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Local development uses deterministic fixtures. Set `remote` only for an HTTPS deployed API.
ADMIN_DATA_SOURCE=fixture
ADMIN_API_ORIGIN=https://admin-api.example.invalid
PLUM_ADMIN_BFF_TOKEN=
# Remote writes are fail-closed in every environment until explicitly enabled.
ADMIN_API_WRITE_ENABLED=false

# Feishu OAuth v3. No ordinary OpenAPI scope is required for this login flow.
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3001/api/auth/feishu/callback

#FEISHU_REDIRECT_URI=https://admin.plum.top/api/auth/feishu/callback
